{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:safe": "prisma generate && node scripts/with-blocked-db.mjs next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "content:check": "node scripts/validate-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "test:hooks": "node .claude/hooks/guard-bash.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shikijs/transformers": "^4.5.0",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "mermaid": "^11.17.2",
    "next": "^16.4.2",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
