{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:safe": "prisma generate && node scripts/with-blocked-db.mjs next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "content:check": "node scripts/validate-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "test:hooks": "node .claude/hooks/guard-bash.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
